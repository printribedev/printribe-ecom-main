# Copy this file to .env and fill it in. Never commit .env.
# Local development database (a single file). Production uses a Postgres connection string.
DATABASE_URL=file:./printribe-dev.db

# Used to encrypt login sessions. Use a long random string.
PAYLOAD_SECRET=CHANGE_ME

# The website address. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Secret used to authenticate scheduled jobs
CRON_SECRET=CHANGE_ME

# Used to validate preview requests
PREVIEW_SECRET=CHANGE_ME

# Razorpay payments. Get these from the Razorpay dashboard (Account & Settings, API Keys).
# Use TEST keys (rzp_test_...) while building; they move no real money. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed once the site is online: the secret you type when creating the webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Production database (Supabase pooler connection string)
POSTGRES_URL=

# Cloudflare R2 (product photos)
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email (Resend). Needed so customers can reset passwords and get order emails.
RESEND_API_KEY=
EMAIL_FROM=
